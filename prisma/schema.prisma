// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. USER & AUTHENTICATION (Better Auth Core)
// ==========================================

model User {
  id            String  @id @default(cuid()) // ⚡ CUID for faster indexing
  name          String
  email         String? @unique
  emailVerified Boolean @default(false)
  image         String?

  phoneNumber         String? @unique
  phoneNumberVerified Boolean @default(false)
  role                Role    @default(CUSTOMER)

  // Profile Details
  dob      DateTime?
  gender   String?
  isVeg    Boolean   @default(false) // Veg-mode toggle
  language String    @default("en")

  // Auth Relations
  sessions Session[]
  accounts Account[]

  // App Relations
  addresses     Address[]
  orders        Order[]              @relation("CustomerOrders")
  reviews       Review[]
  wallet        Wallet?
  savedPayments SavedPaymentMethod[]

  // Role Specific Profiles
  restaurant    Restaurant? // Relation if user is a Manager
  driverProfile DriverProfile? // Relation if user is a Rider

  //  Referral System Fields
  referralCode String  @unique // The code this user shares with others
  referredById String? // The ID of the user who invited them
  referredBy   User?   @relation("UserReferrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("UserReferrals")

  // Partner Onboarding Relations
  restaurantRequest      RestaurantRequest?
  deliveryPartnerRequest DeliveryPartnerRequest?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  couponUsages  CouponUsage[]
  notifications Notification[]

  @@index([referredById])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ==========================================
// 2. CORE BUSINESS LOGIC
// ==========================================

// 📍 Addresses
model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        String  @default("HOME") // HOME, WORK, OTHER
  addressLine String
  landmark    String?
  lat         Float // GPS Latitude
  lng         Float // GPS Longitude
  isDefault   Boolean @default(false)

  @@index([userId])
}

// 🏪 Restaurants
model Restaurant {
  id        String @id @default(cuid())
  managerId String @unique
  manager   User   @relation(fields: [managerId], references: [id])

  name         String
  description  String?
  image        String? // Cover Image URL
  costForTwo   Int // e.g. 500 (approx cost)
  cuisineTypes String[] // ["North Indian", "Chinese"]

  address String
  lat     Float
  lng     Float

  isActive    Boolean @default(true) // Admin ban/unban
  isOpen      Boolean @default(true) // Manager open/close
  isVerified  Boolean @default(false) // Admin approval
  rating      Float   @default(0)
  ratingCount Int     @default(0)

  fssaiCode String? // License ID
  gstNumber String?

  type VegType?

  menuCategories MenuCategory[]
  orders         Order[]
  reviews        Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 📂 Menu Structure
model MenuCategory {
  id           String     @id @default(cuid())
  name         String // "Starters", "Main Course"
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  type         VegType?
  items        MenuItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId])
}

// 🍔 Food Items
model MenuItem {
  id         String       @id @default(cuid())
  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name        String
  description String?
  price       Float
  image       String?
  type        VegType? // VEG, NON_VEG, etc.

  isAvailable  Boolean @default(true)
  isBestseller Boolean @default(false)
  spiceLevel   String? // "Medium", "Spicy"
  prepTime     Int? // In minutes

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

// 🛵 Delivery Partners (Riders)
model DriverProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status     DriverStatus @default(OFFLINE)
  currentLat Float?
  currentLng Float?

  vehicleType   String // "Bike", "Scooter"
  licenseNumber String
  vehiclePlate  String

  rating          Float @default(5.0)
  ratingCount     Int   @default(0)
  totalDeliveries Int   @default(0)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 3. ORDER ENGINE & FINANCIALS
// ==========================================

model Order {
  id String @id @default(cuid())

  // Participants
  customerId String
  customer   User   @relation("CustomerOrders", fields: [customerId], references: [id])

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  driverId String?
  driver   DriverProfile? @relation(fields: [driverId], references: [id])

  // Status & Tracking
  status             OrderStatus @default(PLACED)
  otp                String? // Delivery confirmation
  cancellationReason String?

  // Money
  itemTotal      Float // Sum of items
  tax            Float // GST
  deliveryCharge Float
  platformFee    Float
  driverTip      Float   @default(0)
  discount       Float   @default(0) // Coupon discount applied
  promoCode      String? // Applied coupon code
  commission     Float   @default(0) // Platform cut from restaurant
  totalAmount    Float // Final Amount to Pay

  paymentMode PaymentMethod
  isPaid      Boolean       @default(false)

  // Timestamps
  placedAt    DateTime  @default(now())
  acceptedAt  DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?

  // Relations
  items    OrderItem[]
  payments Payment[]
  refunds  Refund[]
  review   Review?

  @@index([customerId])
  @@index([restaurantId])
  @@index([driverId])
  @@index([status])
  @@index([placedAt])
}

// 🧾 Line Items (Pivot)
model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  quantity Int
  price    Float // Snapshot of price at time of order

  @@index([orderId])
  @@index([menuItemId])
}

// 💳 Payments
model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  amount Float
  method PaymentMethod
  status PaymentStatus @default(PENDING)

  transactionId   String? @unique // From Razorpay/Stripe
  gatewayResponse Json? // Full log

  createdAt DateTime @default(now())

  @@index([orderId])
}

// 🏦 Saved Cards/UPI
model SavedPaymentMethod {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type         String // "CARD", "UPI"
  displayValue String // "**** 4242"
  token        String // Secure token from Gateway
  isDefault    Boolean @default(false)

  @@index([userId])
}

// 💰 Wallet System
model Wallet {
  id            String               @id @default(cuid())
  userId        String               @unique
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance       Float                @default(0.0)
  transactions  WalletTransaction[]
  topupRequests WalletTopupRequest[]
}

model WalletTransaction {
  id        String               @id @default(cuid())
  walletId  String
  wallet    Wallet               @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount    Float // Always positive — direction indicates credit/debit
  direction TransactionDirection // CREDIT or DEBIT
  type      String // "REFUND", "TOPUP", "ORDER_PAYMENT", "REFERRAL_BONUS"
  createdAt DateTime             @default(now())

  @@index([walletId])
}

model WalletTopupRequest {
  id              String        @id @default(cuid())
  walletId        String
  wallet          Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount          Float
  status          PaymentStatus @default(PENDING) // From PaymentStatus enum
  razorpayOrderId String?       @unique
  createdAt       DateTime      @default(now())
}

// 💸 Refunds
model Refund {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  amount    Float
  reason    String
  status    String // "PROCESSED", "PENDING"
  isAuto    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([orderId])
}

// ⭐ Ratings
model Review {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  foodRating     Int // 1-5
  deliveryRating Int // 1-5
  comment        String?

  createdAt DateTime @default(now())

  @@index([restaurantId])
  @@index([userId])
}

// ==========================================
// 6. PROMOTIONS & NOTIFICATIONS
// ==========================================

// 🎟️ Promo/Coupon System
model Coupon {
  id   String @id @default(cuid())
  code String @unique // e.g. "SAVE50", "WELCOME20"

  discountType  String // "PERCENTAGE" or "FLAT"
  discountValue Float // e.g. 20 (means 20% or ₹20)
  maxDiscount   Float? // Cap for percentage discounts (e.g. max ₹100 off)
  minOrder      Float  @default(0) // Minimum order amount to apply

  usageLimit   Int? // Total times this coupon can be used across all users
  perUserLimit Int  @default(1) // Times a single user can use it
  timesUsed    Int  @default(0) // Counter

  validFrom DateTime @default(now())
  validTo   DateTime

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  usages CouponUsage[]
}

model CouponUsage {
  id       String @id @default(cuid())
  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id])
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  orderId  String

  usedAt DateTime @default(now())

  @@unique([couponId, userId, orderId])
  @@index([couponId])
  @@index([userId])
}

// 🔔 Push Notifications
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title  String
  body   String
  type   String // "ORDER_UPDATE", "PROMO", "SYSTEM"
  data   Json? // Extra payload (e.g. { orderId: "..." })
  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ⚙️ Admin-Controlled App Configuration
model AppConfig {
  key       String   @id // e.g. "referral_enabled", "referrer_reward"
  value     String // Stored as string, parsed at runtime
  updatedAt DateTime @updatedAt
}

// ==========================================
// 5. PARTNER ONBOARDING REQUESTS
// ==========================================

// 🏪 Restaurant Partner Application
model RestaurantRequest {
  id     String @id @default(cuid())
  userId String @unique // One application per user
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Form Data (submitted by the applicant)
  restaurantName String
  description    String?
  address        String
  lat            Float
  lng            Float
  cuisineTypes   String[]
  costForTwo     Int
  fssaiCode      String
  gstNumber      String?

  // Admin Review
  status          RequestStatus @default(PENDING)
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// 🛵 Delivery Partner Application
model DeliveryPartnerRequest {
  id     String @id @default(cuid())
  userId String @unique // One application per user
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Form Data (submitted by the applicant)
  vehicleType   String // "Bike", "Scooter"
  licenseNumber String
  vehiclePlate  String

  // Admin Review
  status          RequestStatus @default(PENDING)
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ==========================================
// 4. ENUMS (Business Rules)
// ==========================================

enum Role {
  CUSTOMER
  ADMIN
  RESTAURANT_MANAGER
  DELIVERY_PARTNER
  SUPPORT_AGENT
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  CANCELLED
  REFUSED
}

enum DriverStatus {
  OFFLINE
  ONLINE
  BUSY
}

enum VegType {
  VEG
  NON_VEG
  VEGAN
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  RAZORPAY
  WALLET
  COD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum TransactionDirection {
  CREDIT
  DEBIT
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}
