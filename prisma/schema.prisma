// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. USER & AUTHENTICATION (Better Auth Core)
// ==========================================

model User {
  id            String  @id @default(cuid()) // ⚡ CUID for faster indexing
  name          String
  email         String? @unique
  emailVerified Boolean @default(false)
  image         String?

  phoneNumber         String? @unique
  phoneNumberVerified Boolean @default(false)
  role                Role    @default(CUSTOMER)

  // Profile Details
  dob      DateTime?
  gender   String?
  isVeg    Boolean   @default(false) // Veg-mode toggle
  language String    @default("en")

  // Auth Relations
  sessions Session[]
  accounts Account[]

  // App Relations
  addresses     Address[]
  orders        Order[]              @relation("CustomerOrders")
  reviews       Review[]
  wallet        Wallet?
  savedPayments SavedPaymentMethod[]

  // Role Specific Profiles
  restaurant    Restaurant? // Relation if user is a Manager
  driverProfile DriverProfile? // Relation if user is a Rider
  store         Store? // Relation if user is a Store Manager
  pickerProfile StorePicker? // Relation if user is a warehouse picker

  //  Referral System Fields
  referralCode String  @unique // The code this user shares with others
  referredById String? // The ID of the user who invited them
  referredBy   User?   @relation("UserReferrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("UserReferrals")

  // Partner Onboarding Relations
  restaurantRequest      RestaurantRequest?
  deliveryPartnerRequest DeliveryPartnerRequest?
  storeRequest           StoreRequest?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  couponUsages      CouponUsage[]
  notifications     Notification[]
  communicationLogs CommunicationLog[]
  withdrawals       Withdrawal[]
  recentSearches    RecentSearch[]

  @@index([referredById])
  @@index([role])
  @@index([phoneNumber])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  pushToken String? // Added for Expo Push Notifications

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}
// This is actually one of the authentication tables, not a user profile table. 
// Its purpose is to store temporary verification data such as OTPs, 
// email verification tokens, password reset tokens, etc.

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ==========================================
// 2. CORE BUSINESS LOGIC
// ==========================================

// 📍 Addresses
model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          String  @default("HOME") // HOME, WORK, OTHER
  addressLine   String
  landmark      String?
  receiverName  String? // Added: Who is receiving the order
  receiverPhone String? // Added: Contact number for this specific address
  lat           Float // GPS Latitude
  lng           Float // GPS Longitude
  isDefault     Boolean @default(false)

  orders Order[] @relation("OrderAddress")

  @@index([userId])
}

// 🏪 Restaurants
model Restaurant {
  id        String @id @default(cuid())
  managerId String @unique
  manager   User   @relation(fields: [managerId], references: [id])

  name         String
  description  String?
  logo         String? // Square logo URL
  banner       String? // Large banner URL
  image        String? // Legacy Cover Image URL
  costForTwo   Int // e.g. 500 (approx cost)
  cuisineTypes String[] // ["North Indian", "Chinese"]

  address String
  lat     Float
  lng     Float

  isActive    Boolean @default(true) // Admin ban/unban
  isOpen      Boolean @default(true) // Manager open/close
  isVerified  Boolean @default(false) // Admin approval
  rating      Float   @default(0)
  ratingCount Int     @default(0)

  fssaiCode String? // License ID
  gstNumber String?

  type VegType?

  menuCategories MenuCategory[]
  orders         Order[]
  reviews        Review[]
  settlements    Settlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, isVerified, isOpen])
}

// 📂 Menu Structure
model MenuCategory {
  id           String     @id @default(cuid())
  name         String // "Starters", "Main Course"
  restaurantId String
  image        String?
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  type         VegType?
  items        MenuItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId])
}

// 🍔 Food Items
model MenuItem {
  id         String       @id @default(cuid())
  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name        String
  description String?
  image       String?
  type        VegType? // VEG, NON_VEG, etc.

  isAvailable  Boolean @default(true)
  isBestseller Boolean @default(false)
  spiceLevel   String? // "Medium", "Spicy"
  prepTime     Int? // In minutes

  orderItems OrderItem[]
  variants   MenuVariant[]
  addons     AddonGroup[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([categoryId])
  @@index([isAvailable])
}

model MenuVariant {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  name      String // Quarter, Half, Full, Small, Medium, Large
  price     Float
  salePrice Float?

  quantity    String? // "250ml", "500g", "2 pcs"
  servingSize String? // optional

  stock       Int?
  isDefault   Boolean @default(false)
  isAvailable Boolean @default(true)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuItemId])
}

model AddonGroup {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  name      String // "Extra Toppings"
  minSelect Int    @default(0)
  maxSelect Int?

  options AddonOption[]
}

model AddonOption {
  id           String     @id @default(cuid())
  addonGroupId String
  addonGroup   AddonGroup @relation(fields: [addonGroupId], references: [id], onDelete: Cascade)

  name        String
  price       Float
  isAvailable Boolean @default(true)

  orderItemAddons OrderItemAddon[]
}

// 🛵 Delivery Partners (Riders)
model DriverProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status     DriverStatus @default(OFFLINE)
  currentLat Float?
  currentLng Float?

  vehicleType   String // "Bike", "Scooter"
  licenseNumber String
  vehiclePlate  String
  profilePic    String? // Driver face photo

  rating          Float @default(5.0)
  ratingCount     Int   @default(0)
  totalDeliveries Int   @default(0)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([status, currentLat, currentLng])
}

// ==========================================
// 3. ORDER ENGINE & FINANCIALS
// ==========================================

model Order {
  id   String    @id @default(cuid())
  type OrderType @default(FOOD) // 🚀 Distinguishes food vs grocery orders

  // Participants
  customerId String
  customer   User   @relation("CustomerOrders", fields: [customerId], references: [id])

  // Merchant (one of these will be populated based on OrderType)
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])

  storeId String?
  store   Store?  @relation("StoreOrders", fields: [storeId], references: [id])

  driverId String?
  driver   DriverProfile? @relation(fields: [driverId], references: [id])

  // Warehouse picker assigned to this grocery order
  pickerId String?
  picker   StorePicker? @relation(fields: [pickerId], references: [id])

  // Address Snapshot (Frozen at time of order)
  addressId             String?
  address               Address? @relation("OrderAddress", fields: [addressId], references: [id], onDelete: SetNull)
  deliveryAddressLine   String?
  deliveryLandmark      String?
  deliveryReceiverName  String?
  deliveryReceiverPhone String?
  deliveryLat           Float?
  deliveryLng           Float?

  // Status & Tracking
  status             OrderStatus @default(PLACED)
  otp                String? // Delivery confirmation
  cancellationReason String?

  // Money
  itemTotal      Float // Sum of items
  tax            Float // GST
  deliveryCharge Float
  platformFee    Float
  driverTip      Float   @default(0)
  discount       Float   @default(0) // Coupon discount applied
  promoCode      String? // Applied coupon code
  commission     Float   @default(0) // Platform cut from merchant
  totalAmount    Float // Final Amount to Pay

  paymentMode PaymentMethod
  isPaid      Boolean       @default(false)

  // Timestamps
  placedAt    DateTime  @default(now())
  acceptedAt  DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?

  // Relations
  items    OrderItem[]
  payments Payment[]
  refunds  Refund[]
  review   Review?

  @@index([customerId])
  @@index([restaurantId])
  @@index([storeId])
  @@index([driverId])
  @@index([pickerId])
  @@index([addressId])
  @@index([status])
  @@index([type])
  @@index([placedAt])
}

// 🏧 Wallet Withdrawals (Payouts)
model Withdrawal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  amount Float
  status RequestStatus @default(PENDING) // PENDING, APPROVED, REJECTED

  bankAccountName   String
  bankAccountNumber String
  ifscCode          String

  rejectionReason String?
  processedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// 🧾 Line Items (Pivot)
model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Food order fields (populated for FOOD orders)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id])

  variantId String?
  variant   MenuVariant? @relation(fields: [variantId], references: [id])

  // Grocery order fields (populated for GROCERY orders)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  quantity Int

  itemName    String
  variantName String?

  unitPrice   Float
  addonsPrice Float @default(0)
  totalPrice  Float

  selectedAddons OrderItemAddon[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model OrderItemAddon {
  id String @id @default(cuid())

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  addonOptionId String?
  addonOption   AddonOption? @relation(fields: [addonOptionId], references: [id])

  // snapshot
  name     String
  price    Float
  quantity Int    @default(1)

  createdAt DateTime @default(now())

  @@index([orderItemId])
}

// 💳 Payments
model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  amount Float
  method PaymentMethod
  status PaymentStatus @default(PENDING)

  transactionId   String? @unique // From Razorpay/Stripe
  gatewayResponse Json? // Full log

  createdAt DateTime @default(now())

  @@index([orderId])
}

// 🏦 Saved Cards/UPI
model SavedPaymentMethod {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type         String // "CARD", "UPI"
  displayValue String // "**** 4242"
  token        String // Secure token from Gateway
  isDefault    Boolean @default(false)

  @@index([userId])
}

// 💰 Wallet System
model Wallet {
  id            String               @id @default(cuid())
  userId        String               @unique
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance       Float                @default(0.0)
  transactions  WalletTransaction[]
  topupRequests WalletTopupRequest[]
}

model WalletTransaction {
  id        String               @id @default(cuid())
  walletId  String
  wallet    Wallet               @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount    Float // Always positive — direction indicates credit/debit
  direction TransactionDirection // CREDIT or DEBIT
  type      String // "REFUND", "TOPUP", "ORDER_PAYMENT", "REFERRAL_BONUS"
  description String?
  createdAt DateTime             @default(now())

  @@index([walletId])
}

model WalletTopupRequest {
  id              String        @id @default(cuid())
  walletId        String
  wallet          Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount          Float
  status          PaymentStatus @default(PENDING) // From PaymentStatus enum
  razorpayOrderId String?       @unique
  createdAt       DateTime      @default(now())
}

// 💸 Refunds
model Refund {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  amount    Float
  reason    String
  status    String // "PROCESSED", "PENDING"
  isAuto    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([orderId])
}

// ⭐ Ratings
model Review {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  foodRating     Int // 1-5
  deliveryRating Int // 1-5
  comment        String?

  createdAt DateTime @default(now())

  @@index([restaurantId])
  @@index([userId])
}

// ==========================================
// 6. PROMOTIONS & NOTIFICATIONS
// ==========================================

// 🎟️ Promo/Coupon System
model Coupon {
  id   String @id @default(cuid())
  code String @unique // e.g. "SAVE50", "WELCOME20"

  discountType  String // "PERCENTAGE" or "FLAT"
  discountValue Float // e.g. 20 (means 20% or ₹20)
  maxDiscount   Float? // Cap for percentage discounts (e.g. max ₹100 off)
  minOrder      Float  @default(0) // Minimum order amount to apply

  usageLimit   Int? // Total times this coupon can be used across all users
  perUserLimit Int  @default(1) // Times a single user can use it
  timesUsed    Int  @default(0) // Counter

  validFrom DateTime @default(now())
  validTo   DateTime

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  usages CouponUsage[]
}

model CouponUsage {
  id       String @id @default(cuid())
  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id])
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  orderId  String

  discount    Float?  // Amount saved using this coupon
  description String? // e.g. "Saved ₹50 using WELCOME20 on order #a1b2c3"

  usedAt DateTime @default(now())

  @@unique([couponId, userId, orderId])
  @@index([couponId])
  @@index([userId])
}

// 🔔 Push Notifications
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title  String
  body   String
  type   String // "ORDER_UPDATE", "PROMO", "SYSTEM"
  data   Json? // Extra payload (e.g. { orderId: "..." })
  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// 📧 Communication Log (SMS, Email, Push)
model CommunicationLog {
  id String @id @default(cuid())

  channel CommunicationChannel // SMS, EMAIL, PUSH
  event   String // "LOGIN_OTP", "ORDER_CONFIRMATION", etc.
  to      String // Phone, Email, or User ID
  userId  String?
  user    User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  subject      String? // For emails
  template     String? // Template name used
  templateData Json? // Variables passed to template

  status            CommunicationStatus @default(PENDING)
  providerName      String? // "exotel", "resend", "expo"
  providerMessageId String? // ID from provider for tracking

  attempts    Int     @default(0)
  maxAttempts Int     @default(3)
  error       String? // Last error message

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sentAt    DateTime?

  @@index([userId])
  @@index([channel])
  @@index([status])
  @@index([event])
  @@index([createdAt])
}

// ⚙️ Admin-Controlled App Configuration
model AppConfig {
  key       String   @id // e.g. "referral_enabled", "referrer_reward"
  value     String // Stored as string, parsed at runtime
  updatedAt DateTime @updatedAt
}

// ==========================================
// 5. PARTNER ONBOARDING REQUESTS
// ==========================================

// 🏪 Restaurant Partner Application
model RestaurantRequest {
  id     String @id @default(cuid())
  userId String @unique // One application per user
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Form Data (submitted by the applicant)
  restaurantName String
  description    String?
  address        String
  lat            Float
  lng            Float
  cuisineTypes   String[]
  costForTwo     Int
  fssaiCode      String
  gstNumber      String?
  logoUrl        String?
  bannerUrl      String?
  fssaiDocUrl    String? // Image/PDF of FSSAI certificate

  // Admin Review
  status          RequestStatus @default(PENDING)
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// 🛵 Delivery Partner Application
model DeliveryPartnerRequest {
  id     String @id @default(cuid())
  userId String @unique // One application per user
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Form Data (submitted by the applicant)
  vehicleType     String // "Bike", "Scooter"
  licenseNumber   String
  vehiclePlate    String
  licenseFrontUrl String?
  licenseBackUrl  String?
  vehicleRcUrl    String?
  profilePicUrl   String?
  phoneNumber     String?
  email           String?

  // Admin Review
  status          RequestStatus @default(PENDING)
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// 🔍 Recent Searches & Discovery
model RecentSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("recent_search")
}

model Cuisine {
  id        String   @id @default(cuid())
  name      String   @unique
  image     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cuisine")
}

// ==========================================
// 4. ENUMS (Business Rules)
// ==========================================

enum Role {
  CUSTOMER
  ADMIN
  RESTAURANT_MANAGER
  DELIVERY_PARTNER
  SUPPORT_AGENT
  STORE_MANAGER // 🛒 Dark store / grocery partner
  STORE_PICKER  // 🧑‍🏭 Warehouse picker staff
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  CANCELLED
  REFUSED
}

enum DriverStatus {
  OFFLINE
  ONLINE
  BUSY
}

enum VegType {
  VEG
  NON_VEG
  VEGAN
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  RAZORPAY
  WALLET
  COD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum TransactionDirection {
  CREDIT
  DEBIT
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CommunicationChannel {
  SMS
  EMAIL
  PUSH
}

enum CommunicationStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

enum OrderType {
  FOOD
  GROCERY
}

enum PickerStatus {
  AVAILABLE  // Ready to pick new orders
  PICKING    // Currently picking/packing an order
  ON_BREAK   // Temporarily unavailable
  OFFLINE    // Shift ended / not working
}

model Settlement {
  id           String   @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  amount       Float
  commission   Float
  totalRevenue Float
  status       String   @default("PENDING") // PENDING, PAID
  description  String?  // e.g. "Daily settlement for 15 orders on 2026-06-19"
  settledAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([restaurantId])
  @@index([status])
}

// ==========================================
// 7. INSTAMART — GROCERY CATALOG & INVENTORY
// ==========================================

// 🏬 Dark Store (Grocery Warehouse Partner)
model Store {
  id          String   @id @default(cuid())
  managerId   String   @unique
  manager     User     @relation(fields: [managerId], references: [id])

  name        String
  description String?
  logo        String?
  banner      String?
  address     String
  lat         Float
  lng         Float

  isActive    Boolean  @default(true)  // Admin ban/unban
  isOpen      Boolean  @default(true)  // Manager open/close
  isVerified  Boolean  @default(false) // Admin approval

  categories  StoreCategory[]
  inventory   StoreInventory[]
  orders      Order[]          @relation("StoreOrders")
  pickers     StorePicker[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, isVerified, isOpen])
  @@index([lat, lng])
}

// 🧑‍🏭 Warehouse Picker (Staff at a Dark Store)
model StorePicker {
  id       String @id @default(cuid())
  storeId  String
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])

  name     String   // Display name for the picker
  status   PickerStatus @default(OFFLINE)

  // Stats
  totalOrdersPicked Int @default(0)
  activeOrderCount  Int @default(0) // How many orders currently assigned

  // Orders assigned to this picker
  orders   Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, userId])
  @@index([storeId, status])
}

// 📦 Global Product Catalog
model Product {
  id          String   @id @default(cuid())
  name        String
  brand       String?
  description String?
  image       String?
  barcode     String?  @unique
  sku         String?  @unique
  weight      String?  // e.g. "500g", "1L", "6 pcs"
  unit        String?  // e.g. "kg", "ml", "pcs"

  inventory   StoreInventory[]
  orderItems  OrderItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

// 📊 Store-level Inventory (Stock + Pricing per Store per Product)
model StoreInventory {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  categoryId  String?
  category    StoreCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  stock       Int      @default(0)     // ⚡ Strict inventory — decremented atomically on checkout
  price       Float
  salePrice   Float?
  isAvailable Boolean  @default(true)

  @@unique([storeId, productId])
  @@index([storeId])
  @@index([categoryId])
}

// 🗂️ Store Category Hierarchy (Self-referential for infinite nesting)
model StoreCategory {
  id               String          @id @default(cuid())
  name             String
  image            String?
  storeId          String
  store            Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Self-referential: enables Beverages → Soft Drinks → Cola
  parentCategoryId String?
  parentCategory   StoreCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: Cascade)
  subCategories    StoreCategory[] @relation("CategoryHierarchy")

  inventoryItems   StoreInventory[]

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([storeId])
  @@index([parentCategoryId])
}

// 📋 Store Partner Onboarding Request
model StoreRequest {
  id        String @id @default(cuid())
  userId    String @unique // One application per user
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Form Data
  storeName   String
  description String?
  address     String
  lat         Float
  lng         Float
  gstNumber   String?
  logoUrl     String?
  bannerUrl   String?

  // Admin Review
  status          RequestStatus @default(PENDING)
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}
